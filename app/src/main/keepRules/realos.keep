# -----------------------------------------------------------------------------
# realOS R8 / ProGuard keep rules
#
# This project is an LSPosed module that injects into host processes.
# Entry points, callbacks, and bridges are called reflectively by name by the
# framework; R8 cannot trace these invocations statically. If stripped or renamed,
# the module will fail silently (ClassNotFoundException / NoSuchMethodException).
#
# AGP convention: Keep rule files live in src/<variant>/keepRules/ with .keep extension.
# Default proguard-android-optimize rules are merged automatically via includeDefault.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# 1. LSPosed / libxposed entry points
#
# Entry class names are specified in META-INF/xposed/java_init.list and reflectively
# instantiated via Class.forName. Class name, default parameterless constructor,
# and all override callback methods must be preserved.
# -----------------------------------------------------------------------------
-keep class io.github.ra1nify.realos.xposed.RealOSModule { *; }
-keepclassmembers class io.github.ra1nify.realos.xposed.RealOSModule {
    public <init>();
}

# Any class extending libxposed XposedModule preserves its entry callback contract
-keep class * extends io.github.libxposed.api.XposedModule {
    public <init>();
    public void onModuleLoaded(...);
    public boolean onHotReloading(...);
    public void onHotReloaded(...);
    public void onPackageReady(...);
    public void onSystemServerStarting(...);
    public void onSystemServerStarted(...);
}


# -----------------------------------------------------------------------------
# 2. Hook specification implementations (SpecLoader) - dynamically generated by scope
#
# Dynamic rules are generated at build configuration time in:
#   app/build/generated/scopeKeepRules/realos-scope.keep
# Only enabled scopes emit -keep rules for their SpecLoader implementation classes;
# disabled scope spec classes remain unreachable from SpecRegistry and are pruned by R8.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# 3. Class and package name protection
# -----------------------------------------------------------------------------
-repackageclasses 'io.github.ra1nify.realos'

# Android components are instantiated by the framework by manifest name.
#
# These rules are MODE-AWARE and live in the generated scope keep file
# (src/main/keepRules/realos-scope.keep):
#   - full: every Activity / Service subclass is kept;
#   - lite: only the components that survived the whitelist manifest are kept.
# Keeping the blanket rules here would make every Activity an R8 root in lite
# builds too, which drags the whole app shell (and every feature it reaches)
# into the carrier APK and defeats the whitelist.


# -----------------------------------------------------------------------------
# 4. Host symbol resolution bridges (DexKit + reflection)
#
# Resolvers like OplusInputSymbols dynamically locate targets from host dex at
# runtime via DexKit and restore them reflectively. Preserve member names under
# the hooks package to ensure deterministic runtime reflection paths.
# -----------------------------------------------------------------------------
-keepnames class io.github.ra1nify.realos.xposed.hooks.** { *; }
-keepclassmembers class io.github.ra1nify.realos.xposed.hooks.** {
    <fields>;
    <methods>;
}


# -----------------------------------------------------------------------------
# 5. Kotlin metadata and reflection
# -----------------------------------------------------------------------------
-keep class kotlin.Metadata { *; }
-keepclassmembers class **$WhenMappings {
    <fields>;
}
-keepclassmembers class ** {
    public static final ** INSTANCE;
}
-dontwarn kotlin.**
-dontwarn kotlinx.**


# -----------------------------------------------------------------------------
# 6. kotlinx.serialization
# -----------------------------------------------------------------------------
-keepattributes RuntimeVisibleAnnotations,AnnotationDefault,InnerClasses,Signature,*Annotation*
-keepclassmembers class **$$serializer {
    *** descriptor;
}
-keepclasseswithmembers class ** {
    @kotlinx.serialization.Serializable <fields>;
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,allowshrinking,allowobfuscation class ** implements kotlinx.serialization.KSerializer
-if @kotlinx.serialization.Serializable class **
-keepclassmembers class <1> {
    static <1>$Companion Companion;
}


# -----------------------------------------------------------------------------
# 7. Jetpack Compose
#
# `-keepclassmembers ... @Composable` keeps the member names of composables that
# survive shrinking; it is harmless in both modes.
#
# `-keepclasseswithmembers ... @Composable` keeps EVERY class that declares a
# composable, which makes the whole UI tree an R8 root. That is required for the
# full build but would drag every feature's UI into a lite carrier package, so it
# is emitted only in full mode from the generated scope keep file.
# -----------------------------------------------------------------------------
-keep class androidx.compose.runtime.** { *; }
-keepclassmembers class ** {
    @androidx.compose.runtime.Composable <methods>;
}


# -----------------------------------------------------------------------------
# 8. General rules: JNI / Enum / Parcelable / Serializable
# -----------------------------------------------------------------------------
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}
-keepclassmembers enum * {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}
-keepclassmembers class * implements android.os.Parcelable {
    public static final ** CREATOR;
}
-keepclassmembers class * implements java.io.Serializable {
    static final long serialVersionUID;
    private static final java.io.ObjectStreamField[] serialPersistentFields;
    !static !transient <fields>;
    private void writeObject(java.io.ObjectOutputStream);
    private void readObject(java.io.ObjectInputStream);
    java.lang.Object writeReplace();
    java.lang.Object readResolve();
}


# -----------------------------------------------------------------------------
# 9. Third-party library warning suppression
# -----------------------------------------------------------------------------
-dontwarn org.apache.commons.compress.**
-dontwarn org.tukaani.xz.**
-dontwarn org.bouncycastle.**
-dontwarn org.conscrypt.**
-dontwarn org.openjsse.**
-dontwarn javax.annotation.**
-dontwarn javax.lang.model.**
-dontwarn com.google.errorprone.annotations.**
-dontwarn org.checkerframework.**
-dontwarn org.jetbrains.annotations.**
-dontwarn java.lang.invoke.StringConcatFactory
-dontwarn android.window.**
-dontwarn com.google.protobuf.**
-dontwarn org.luckypray.dexkit.**
